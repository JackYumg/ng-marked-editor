    "katex"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/JackYumg/ng-marked-editor.git",
    "directory": "projects/ng-marked-editor"
  },
  "homepage": "https://github.com/JackYumg/ng-marked-editor#readme",
  "bugs": {
    "url": "https://github.com/JackYumg/ng-marked-editor/issues"
  },
  "peerDependencies": {
    "@angular/animations": "^22.3.0",
    "@angular/cdk": "^22.3.0",
    "@angular/common": "^22.3.0",
    "@angular/core": "^22.3.0",
    "@angular/forms": "^22.3.0",
    "highlight.js": "^11.12.0",
    "katex": "^0.19.1",
    "marked": "^18.2.1",
    "mermaid": "^12.3.0",
    "prettier": "^3.8.1"
  },
  "peerDependenciesMeta": {
    "prettier": {
      "optional": true
    }
  },
